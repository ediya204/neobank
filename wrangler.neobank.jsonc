{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neobank-web",
  "main": "./worker-web/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./build",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "fidere.cloudflareaccess.com",
    "CF_ACCESS_AUD": "71dd34ee6e3265b40b465881dc409d80915dc651b372623aec425f2e21d24da3",
    "NEOBANK_ADMIN_EMAILS": "edi@fideretrust.com",
    "GO_API_BASE_URL": "https://neobank-78pr.onrender.com"
  },
  "secrets": {
    "required": ["GO_EDGE_SHARED_SECRET"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
