{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neobank-web",
  "main": "./worker-web/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "portal.sscdigitalbank.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./build",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "GO_API_BASE_URL": "https://neobank-78pr.onrender.com",
    "CORE_API_BASE_URL": "https://neobank-core.onrender.com",
    "CORE_ORGANIZATION_ID": "org_neobank",
    "CUSTOMER_AUTH_MAINTENANCE": "false"
  },
  "secrets": {
    "required": ["GO_EDGE_SHARED_SECRET", "CORE_EDGE_SHARED_SECRET"]
  },
  "ratelimits": [
    {
      "name": "ADMIN_AUTH_RATE_LIMITER",
      "namespace_id": "2026081601",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "CUSTOMER_AUTH_RATE_LIMITER",
      "namespace_id": "2026081401",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
