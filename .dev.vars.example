# Local development only. Prefer `npm run local:auth:prepare` so random values
# are generated and .dev.vars is set to mode 0600. If you copy this file
# manually, replace every placeholder and run `chmod 600 .dev.vars`.
# Never reuse production values here and never commit .dev.vars.
AUTH_ADMIN_EMAIL=local.admin@localhost.test
AUTH_PARTNER_EMAIL=local.partner@localhost.test
API_CREDENTIAL_LOCAL_DEMO=true
AUTH_BOOTSTRAP_SECRET=<generate-a-local-random-value>
AUTH_TOTP_ENCRYPTION_KEY=<base64url-encoded-32-byte-local-key>
AUTH_PASSWORD_PEPPER=<generate-a-local-random-value>
AUTH_RECOVERY_CODE_PEPPER=<generate-a-local-random-value>
AUTH_SESSION_SECRET=<generate-a-local-random-value>
PARTNER_WEBHOOK_SIGNING_SECRET=<generate-a-local-random-value>
